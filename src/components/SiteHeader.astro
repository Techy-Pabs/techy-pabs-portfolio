---
import ArrowIcon from './ArrowIcon.astro';
import Button from './Button.astro';
import Logo from './Logo.astro';
import { navLinks, site } from '../site';

// "/portfolio/shopassist/" -> "/portfolio/shopassist", so Portfolio stays highlighted on case studies.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// The header button. On the contact page "Start a project" would link to itself, so it offers
// Upwork instead, and is left out until the Upwork link is filled in.
const cta =
  path === '/contact'
    ? site.upwork
      ? { label: 'Hire on Upwork', href: site.upwork, external: true }
      : null
    : { label: 'Start a project', href: '/contact', external: false };
const ctaTarget = cta?.external ? { target: '_blank', rel: 'noopener' } : {};
---

<!--
  One full width bar: the gradient and bottom border span the viewport, the contents stay inside
  container-site. It sits over the top of each page (absolute); every hero's top padding starts
  its content below the bar.
-->
<header class="absolute inset-x-0 top-0 z-30 border-b border-line bg-[linear-gradient(180deg,#000000_0%,#1c1d20_100%)]">
  <div class="container-site flex h-20 items-center justify-between gap-6 md:grid md:h-24 md:grid-cols-[1fr_auto_1fr]">
    <Logo compactOnTablet />

    <!-- Desktop: plain text links, centred. The current page is amber. -->
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-6 lg:gap-10">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center text-[17px] font-medium whitespace-nowrap transition-colors hover:text-amber',
                  isCurrent(link.href) ? 'text-amber' : 'text-light',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Desktop: filled call-to-action button. -->
    <div class="hidden justify-self-end md:block">
      {
        cta && (
          <Button href={cta.href} external={cta.external} arrow class="whitespace-nowrap">
            {cta.label}
          </Button>
        )
      }
    </div>

    <!-- Phone: round menu button that opens the full screen menu below. -->
    <button
      type="button"
      class="grid size-12 place-items-center rounded-full border border-amber text-amber md:hidden"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-open
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M9 14h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!--
    <dialog> is the browser's built-in modal. showModal() traps keyboard focus inside it,
    makes the page behind it unclickable and closes it on Escape, so we write very little JS.
  -->
  <dialog
    id="site-menu"
    aria-label="Menu"
    class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-hero p-0 text-white open:flex backdrop:bg-black"
  >
    <div class="container-site flex flex-1 flex-col py-6">
      <div class="flex items-center justify-between">
        <Logo />
        <button
          type="button"
          class="grid size-12 place-items-center rounded-full bg-amber text-black"
          aria-label="Close menu"
          autofocus
          data-menu-close
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Menu" class="mt-10">
        <ul class="border-t border-line">
          {
            navLinks.map((link) => (
              <li class="border-b border-line">
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center justify-between gap-4 py-4 text-[32px] leading-tight font-bold tracking-heading',
                    isCurrent(link.href) ? 'text-amber' : 'text-white',
                  ]}
                >
                  {link.label}
                  <ArrowIcon class:list={['text-xl', !isCurrent(link.href) && 'text-text-muted']} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        cta && (
          <a
            href={cta.href}
            {...ctaTarget}
            class="mt-6 flex min-h-12 items-center justify-center gap-2 rounded-full bg-button-primary font-button text-base font-medium tracking-label text-black"
          >
            {cta.label} <ArrowIcon />
          </a>
        )
      }
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (menu && openButton && closeButton) {
    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden'; // stop the page scrolling behind the menu
    });

    closeButton.addEventListener('click', () => menu.close());

    // Runs however the menu closes: close button, Escape key, or the code below.
    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    });

    // If the window is widened past 760 px while the menu is open, close it.
    window.matchMedia('(min-width: 760px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
