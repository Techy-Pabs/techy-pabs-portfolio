---
// The direct ways to get in touch, from site.ts. Upwork appears once its link is filled in.
import ArrowIcon from '../ArrowIcon.astro';
import { contactChannels } from '../../site';
---

<ul class="space-y-2.5" aria-label="Contact me directly">
  {
    contactChannels.map((channel) => (
      <li>
        <a
          href={channel.href}
          {...(channel.external && { target: '_blank', rel: 'noopener' })}
          class="group flex min-h-[76px] items-center justify-between gap-4 rounded-2xl border border-line bg-charcoal px-6 py-4 transition-colors hover:border-amber"
        >
          <span class="min-w-0">
            <span class="block font-mono text-[11px] tracking-widest text-text-muted uppercase">{channel.kind}</span>
            <span class="mt-1 block truncate text-[17px] font-semibold">{channel.detail}</span>
          </span>
          <ArrowIcon class="text-xl text-amber transition-transform motion-safe:group-hover:translate-x-1" />
        </a>
      </li>
    ))
  }
</ul>
