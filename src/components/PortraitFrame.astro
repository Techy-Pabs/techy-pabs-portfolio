---
/*
  A cutout portrait whose head rises above a coloured block.
  The box is exactly the image's shape; the block fills it from `frameTop` down,
  and the transparent image sits on top. Extra cards can be placed over it with the slot.
*/
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: { src: ImageMetadata; alt: string };
  frameClass: string; // colour of the block, e.g. "bg-amber"
  frameTop: string; // where the block starts, as a % of the image height
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { image, frameClass, frameTop, sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['relative', className]}>
  <div class:list={['absolute inset-x-0 bottom-0 rounded-t-card-lg', frameClass]} style={`top: ${frameTop}`}></div>
  <Image
    src={image.src}
    alt={image.alt}
    widths={[400, 800]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="relative block h-auto w-full"
  />
  <slot />
</div>
