---
import Pill from '../Pill.astro';
import { servicesPage } from '../../data/services-page';
---

<!-- id="process" is the footer's "How I work" link. -->
<section id="process" class="bg-light py-24 text-charcoal md:py-28">
  <div class="container-site">
    <div class="text-center">
      <Pill tone="light">Process</Pill>
      <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">{servicesPage.process.title}</h2>
    </div>
    <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        servicesPage.process.steps.map((step, i) => (
          <li class="rounded-card border-t-4 border-amber bg-white p-8">
            <p class="font-mono text-sm text-text-muted-light">Step {String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-2xl leading-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-text-muted-light">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
