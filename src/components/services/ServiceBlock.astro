---
import { render, type CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import { serviceHref } from '../../lib/services';

interface Props {
  service: CollectionEntry<'services'>;
  number: number;
}

const { service, number } = Astro.props;
const { title, goodFor, deliverables } = service.data;
const { Content } = await render(service); // the longer description from the Markdown body
const href = serviceHref(service.id);
---

<article
  class="grid gap-10 rounded-card-lg border border-line bg-charcoal p-8 md:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,376px)] lg:items-center"
>
  <div>
    <p class="font-mono text-sm text-amber">{String(number).padStart(2, '0')}</p>
    <h2 class="mt-3 text-[clamp(2rem,3.4vw,2.75rem)] leading-tight">
      <a href={href} class="hover:text-amber">{title}</a>
    </h2>
    <div class="mt-4 max-w-2xl text-lg leading-relaxed text-text-muted"><Content /></div>
    <p class="mt-5 text-[15px] text-text-soft">Good for: {goodFor.join(', ')}.</p>
    <a href={href} class="mt-6 inline-flex min-h-11 items-center gap-1.5 font-semibold text-amber hover:underline">
      Explore {title}
      <ArrowIcon />
    </a>
  </div>

  <div class="rounded-card bg-black p-7">
    <h3 class="font-pill text-[15px] font-normal tracking-label text-amber">What you get</h3>
    <ul class="mt-4 space-y-3">
      {
        deliverables.map((item) => (
          <li class="flex items-center gap-3">
            <span class="size-2.5 shrink-0 rounded-full bg-amber" aria-hidden="true" />
            {item.title}
          </li>
        ))
      }
    </ul>
  </div>
</article>
