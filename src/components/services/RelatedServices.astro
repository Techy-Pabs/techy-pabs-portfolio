---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import { serviceHref } from '../../lib/services';

interface Props {
  services: CollectionEntry<'services'>[]; // every service except the current one
}

const { services } = Astro.props;
---

{
  services.length > 0 && (
    <section class="bg-black pb-8">
      <div class="container-site">
        <h2 class="text-[clamp(2rem,3.4vw,2.75rem)] leading-tight">Related services</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {services.map((service) => (
            <li>
              <a
                href={serviceHref(service.id)}
                class="group flex h-full items-center justify-between gap-6 rounded-card border border-line bg-charcoal p-7 transition-colors hover:border-amber"
              >
                <span>
                  <span class="block text-[22px] leading-tight font-semibold tracking-[-0.01em]">{service.data.title}</span>
                  <span class="mt-1.5 block text-text-muted">{service.data.tagline}</span>
                </span>
                <span
                  class="grid size-12 shrink-0 place-items-center rounded-full bg-amber text-lg text-black transition-transform motion-safe:group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <ArrowIcon />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
