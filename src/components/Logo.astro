---
import { site } from '../site';

interface Props {
  // Between 760 and 1024 px the header has no room for the name beside the five nav links,
  // so it shows just the "tp" tile there (the name stays available to screen readers).
  compactOnTablet?: boolean;
}

const { compactOnTablet = false } = Astro.props;
---

<a href="/" class="flex min-h-11 items-center gap-3">
  <span
    class="grid size-[38px] place-items-center rounded-[10px] bg-amber font-mono text-[15px] font-medium text-black"
    aria-hidden="true">tp</span
  >
  <span class:list={['text-[17px] font-semibold', compactOnTablet && 'md:max-lg:sr-only']}>{site.name}</span>
</a>
