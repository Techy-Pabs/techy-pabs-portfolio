---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, kind, year, stack, cover, parts } = project.data;

// The cover sits in the middle. The screens either side are the project's landscape part
// screenshots (a tall phone-shaped shot, like a chat panel, does not suit the fan).
const [right, left] = parts.map((part) => part.image).filter((image) => image.src.width > image.src.height);
---

<article class="group relative overflow-hidden rounded-card-lg border border-line bg-charcoal">
  <div class="relative aspect-[2.14] overflow-hidden bg-linear-to-b from-charcoal to-black">
    {
      left && (
        <Image
          src={left.src}
          alt={left.alt}
          widths={[320, 640]}
          sizes="(min-width: 1288px) 500px, 40vw"
          class="absolute top-[10%] left-[5%] w-[40%] -rotate-4 rounded-md shadow-2xl shadow-black/60 transition-transform duration-500 motion-safe:group-hover:-translate-x-2"
        />
      )
    }
    {
      right && (
        <Image
          src={right.src}
          alt={right.alt}
          widths={[320, 640]}
          sizes="(min-width: 1288px) 500px, 40vw"
          class="absolute top-[8.5%] right-[5%] w-[40%] rotate-4 rounded-md shadow-2xl shadow-black/60 transition-transform duration-500 motion-safe:group-hover:translate-x-2"
        />
      )
    }
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={[480, 960, 1300]}
      sizes="(min-width: 1288px) 650px, 52vw"
      class="absolute top-[20%] left-1/2 w-[52%] -translate-x-1/2 rounded-lg border-[3px] border-amber shadow-2xl shadow-black/70"
    />
  </div>

  <div class="grid gap-6 p-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
    <div>
      <p class="font-mono text-[13px] tracking-widest text-text-muted uppercase">{kind} · {year}</p>
      <h3 class="mt-3 text-[clamp(2.25rem,3vw,2.5rem)] leading-tight">
        <!-- The link's ::after covers the whole card, so anywhere on it opens the case study. -->
        <a href={`/work/${project.id}`} class="after:absolute after:inset-0 group-hover:text-amber">{title}</a>
      </h3>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-text-muted">{summary}</p>
    </div>
    <ul class="flex max-w-60 flex-wrap gap-2 md:justify-end" aria-label="Stack">
      {
        stack.map((item) => (
          <li class="rounded-full border border-line px-3.5 py-1.5 font-mono text-[13px] text-text-soft">{item}</li>
        ))
      }
    </ul>
  </div>
</article>
