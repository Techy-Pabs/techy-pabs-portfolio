---
import { getCollection } from 'astro:content';
import Button from '../Button.astro';
import Pill from '../Pill.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectGridCard from './ProjectGridCard.astro';
import { newestFirst } from '../../lib/projects';

// Up to four featured projects: the newest shipped one as the large card, the rest in a grid below.
const featured = (await getCollection('projects', (project) => project.data.featured)).sort(newestFirst).slice(0, 4);
const [latest, ...others] = featured;
---

{
  latest && (
    <section class="bg-black py-24 md:py-28">
      <div class="container-site">
        <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <Pill>Selected work</Pill>
            <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">
              Shipped, live, <span class="text-amber">documented.</span>
            </h2>
          </div>
          <Button href="/portfolio" variant="amber" arrow>
            All projects
          </Button>
        </div>

        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          <li class="md:col-span-2">
            <ProjectCard project={latest} />
          </li>
          {others.map((project, i) => (
            <li>
              <ProjectGridCard project={project} backdrop={i % 2 === 0 ? 'amber' : 'light'} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
