---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';

interface Props {
  service: CollectionEntry<'services'>;
  number: number;
}

const { service, number } = Astro.props;
const { title, summary, proof } = service.data;
---

<li
  class="flex flex-col rounded-card border-t-4 border-amber bg-light p-8 text-charcoal transition-transform duration-300 motion-safe:hover:-translate-y-1.5"
>
  <p class="font-mono text-[13px] text-text-muted-light">{String(number).padStart(2, '0')}</p>
  <h3 class="mt-5 text-[26px] leading-tight">{title}</h3>
  <p class="mt-4 leading-relaxed text-text-muted-light">{summary}</p>
  <a
    href={`/work/${proof.project.id}#${proof.section}`}
    class="mt-auto inline-flex min-h-11 items-center gap-1.5 pt-10 text-sm font-semibold hover:text-black hover:underline"
  >
    {proof.label}
    <ArrowIcon />
  </a>
</li>
