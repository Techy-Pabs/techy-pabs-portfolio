---
import type { CollectionEntry } from 'astro:content';
import Pill from '../Pill.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { results, nextSteps } = Astro.props.project.data;
---

<section id="results" class="bg-black pt-20 md:pt-24">
  <div class="container-site">
    <Pill as="h2">Results and next steps</Pill>
    <div class:list={['mt-6 grid gap-4', nextSteps.length > 0 && 'md:grid-cols-2']}>
      <div class="rounded-card-lg border-t-4 border-amber bg-light p-9 text-charcoal">
        <h3 class="text-[28px]">What it delivers</h3>
        <ul class="mt-6 list-disc space-y-3 pl-5 leading-relaxed text-text-muted-light marker:text-charcoal">
          {results.map((result) => <li>{result}</li>)}
        </ul>
      </div>
      {
        nextSteps.length > 0 && (
          <div class="rounded-card-lg border border-line bg-charcoal p-9">
            <h3 class="text-[28px]">What I'd build next</h3>
            <ul class="mt-6 list-disc space-y-3 pl-5 leading-relaxed text-text-muted marker:text-text-soft">
              {nextSteps.map((step) => <li>{step}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
