---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import Pill from '../Pill.astro';
import { splitLastWord } from '../../lib/text';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { diagram, decisions } = Astro.props.project.data;
const heading = splitLastWord(diagram.title);
const lastIndex = diagram.steps.length - 1;
---

<section id="under-the-hood" class="bg-charcoal py-24 md:py-28">
  <div class="container-site">
    <Pill>Under the hood</Pill>
    <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">
      {heading.before}<span class="text-amber">{heading.last}</span>
    </h2>

    <!--
      The request's path through the system: a row on desktop, a column on phones.
      data-diagram: it draws step by step as it scrolls into view (script below).
    -->
    <ol
      class="mt-12 flex flex-col items-stretch gap-3 rounded-card-lg bg-black p-6 md:p-10 lg:flex-row lg:items-center"
      data-diagram
    >
      {
        diagram.steps.map((step, i) => (
          <li class="flex flex-col items-center gap-3 lg:flex-1 lg:flex-row">
            <div
              class:list={[
                'w-full rounded-xl border px-5 py-4 font-mono lg:min-h-[92px]',
                step.highlight
                  ? 'border-amber bg-amber text-black'
                  : i === lastIndex
                    ? 'border-light bg-light text-black' // the final step is the output
                    : 'border-line text-white',
              ]}
            >
              <p class:list={['text-[11px] tracking-wider uppercase', step.highlight || i === lastIndex ? 'text-black/70' : 'text-text-muted']}>
                {step.label}
              </p>
              <p class="mt-1.5 text-[15px] leading-snug">{step.text}</p>
            </div>
            {i < lastIndex && <ArrowIcon class="shrink-0 rotate-90 text-amber lg:rotate-0" />}
          </li>
        ))
      }
    </ol>

    <ul class="mt-6 grid gap-x-6 md:grid-cols-3">
      {
        decisions.map((decision) => (
          <li class="border-t border-line py-8">
            <h3 class="text-lg tracking-[-0.01em]">{decision.title}</h3>
            <p class="mt-2 leading-relaxed text-text-muted">{decision.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { whenNear } from '../../lib/motion';

  for (const diagram of document.querySelectorAll<HTMLElement>('[data-diagram]')) {
    whenNear(diagram, ({ gsap, CLEAR }) => {
      // Each step box appears, then the arrow to the next one, in order.
      const timeline = gsap.timeline({ scrollTrigger: { trigger: diagram, start: 'top 75%', once: true } });
      for (const step of diagram.children) {
        const box = step.firstElementChild;
        const arrow = step.querySelector(':scope > svg');
        timeline.from(box, { opacity: 0, scale: 0.92, duration: 0.45, ease: 'back.out(1.6)', clearProps: CLEAR });
        if (arrow) {
          timeline.from(arrow, { opacity: 0, scale: 0, duration: 0.25, ease: 'power2.out', clearProps: CLEAR }, '-=0.1');
        }
      }
    });
  }
</script>
