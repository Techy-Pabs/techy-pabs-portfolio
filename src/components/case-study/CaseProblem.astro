---
import type { CollectionEntry } from 'astro:content';
import Pill from '../Pill.astro';
import { splitAround } from '../../lib/text';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { problem } = Astro.props.project.data;
const headline = splitAround(problem.headline, problem.highlight);
---

<section id="problem" class="bg-light py-24 text-charcoal md:py-28">
  <div class="container-site grid gap-8 md:grid-cols-[minmax(0,240px)_minmax(0,1fr)] lg:grid-cols-[minmax(0,336px)_minmax(0,1fr)]">
    <div><Pill as="h2" tone="light">The problem</Pill></div>
    <div>
      <p class="text-[clamp(1.5rem,2.4vw,2rem)] leading-[1.3] font-semibold tracking-[-0.02em]">
        {headline.before}<mark class="box-decoration-clone bg-amber px-1.5 text-black">{headline.match}</mark>{headline.after}
      </p>
      <p class="mt-6 text-lg leading-relaxed text-text-muted-light">{problem.body}</p>
    </div>
  </div>
</section>
