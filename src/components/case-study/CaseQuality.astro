---
import type { CollectionEntry } from 'astro:content';
import Pill from '../Pill.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { quality } = Astro.props.project.data;
---

<section id="quality" class="bg-black pt-24 md:pt-28">
  <div class="container-site">
    <Pill as="h2">Quality</Pill>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        quality.map((item) => (
          <li class="rounded-card-lg border border-line bg-charcoal p-7">
            <p class="text-[56px] leading-none font-bold tracking-heading text-amber tabular-nums">
              {/* Screen readers always read the final value; the counting copy is hidden from them. */}
              <span class="sr-only">{item.value}</span>
              <span aria-hidden="true" data-count>
                {item.value}
              </span>
            </p>
            <p class="mt-5 leading-snug text-text-muted">{item.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { CLEAR, gsap, withMotion } from '../../lib/motion';

  withMotion(() => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-count]')) {
      const finalText = el.textContent?.trim() ?? '';
      // "350+" counts 0 → 350 and keeps the "+"; values without a leading number (like "Live") just fade in.
      const match = finalText.match(/^(\d[\d,]*)(.*)$/);
      const trigger = { trigger: el, start: 'top 85%', once: true };

      if (!match) {
        gsap.from(el, { opacity: 0, duration: 0.6, clearProps: CLEAR, scrollTrigger: trigger });
        continue;
      }

      const target = Number(match[1].replaceAll(',', ''));
      const suffix = match[2];
      const counter = { value: 0 };
      gsap.to(counter, {
        value: target,
        duration: 1.6,
        ease: 'power2.out',
        scrollTrigger: trigger,
        onStart: () => (el.textContent = `0${suffix}`),
        onUpdate: () => (el.textContent = `${Math.round(counter.value).toLocaleString('en')}${suffix}`),
        onComplete: () => (el.textContent = finalText),
      });
    }
  });
</script>
