---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import Pill from '../Pill.astro';
import { numberWord, splitLastWord } from '../../lib/text';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { parts, partsTitle } = Astro.props.project.data;
const heading = splitLastWord(partsTitle);
const label = `${numberWord(parts.length)} ${parts.length === 1 ? 'part' : 'parts'}, one system`;

// Each card's screenshot sits on a different backdrop, in this order.
const backdrops = ['bg-amber', 'bg-light', 'bg-black'];
---

<section id="parts" class="bg-black py-24 md:py-28">
  <div class="container-site">
    <div class="mx-auto max-w-3xl text-center">
      <Pill>{label}</Pill>
      <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">
        {heading.before}<span class="text-amber">{heading.last}</span>
      </h2>
    </div>

    <!-- data-reveal: the cards rise in one after another as the list scrolls into view (script below). -->
    <ol class="mt-14 grid gap-4 lg:grid-cols-3" data-reveal>
      {
        parts.map((part, i) => {
          // Tall screenshots (like a chat panel) are shown narrower so they are not blown up.
          const isTall = part.image.src.height > part.image.src.width;
          return (
            <li class="flex flex-col overflow-hidden rounded-card-lg border border-line bg-charcoal">
              <div class:list={['h-[262px] overflow-hidden px-6 pt-6', backdrops[i % backdrops.length]]}>
                <Image
                  src={part.image.src}
                  alt={part.image.alt}
                  widths={[360, 720]}
                  sizes={isTall ? '240px' : '(min-width: 1024px) 360px, calc(100vw - 96px)'}
                  class:list={['h-auto rounded-t-lg shadow-xl shadow-black/30', isTall ? 'mx-auto w-[64%]' : 'w-full']}
                />
              </div>
              <div class="p-7">
                <p class="font-mono text-sm text-amber">
                  {String(i + 1).padStart(2, '0')} · {part.label}
                </p>
                <h3 class="mt-3 text-2xl leading-tight">{part.title}</h3>
                <p class="mt-3 leading-relaxed text-text-muted">{part.body}</p>
                {part.link && (
                  <a
                    href={part.link.href}
                    target="_blank"
                    rel="noopener"
                    class="mt-5 inline-flex min-h-11 items-center gap-1.5 font-semibold text-amber hover:underline"
                  >
                    {part.link.label}
                    <ArrowIcon />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  import { whenNear } from '../../lib/motion';

  for (const list of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
    // Replays each time the cards scroll back into view (see replayOnView in src/lib/gsap.ts).
    whenNear(list, ({ gsap, CLEAR, replayOnView }, visible) => {
      const reveal = gsap.from(list.children, {
        y: 48,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        stagger: 0.18, // one after another
        clearProps: CLEAR,
      });
      replayOnView(list, reveal, visible);
    });
  }
</script>
