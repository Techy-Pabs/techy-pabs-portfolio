---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import CtaBlock from '../CtaBlock.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { links } = Astro.props.project.data;
---

<section class="bg-black pt-24 pb-16 md:pt-28 md:pb-20">
  <div class="container-site">
    <CtaBlock heading="Want something like this for your product?" />

    <nav aria-label="Case study" class="mt-6 flex flex-wrap justify-between gap-4 font-semibold text-amber">
      <a href="/portfolio" class="inline-flex min-h-11 items-center gap-1.5 hover:underline">
        <ArrowIcon direction="left" /> All work
      </a>
      {
        links.code && (
          <a href={links.code} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:underline">
            Read the code on GitHub <ArrowIcon />
          </a>
        )
      }
    </nav>
  </div>
</section>
