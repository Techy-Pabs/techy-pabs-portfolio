---
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from '../ArrowIcon.astro';
import Button from '../Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { links } = Astro.props.project.data;
---

<section class="bg-black pt-24 pb-2 md:pt-28 md:pb-1">
  <div class="container-site">
    <div
      class="grid gap-8 rounded-card-lg bg-button-primary p-12 text-black max-sm:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
    >
      <h2 class="max-w-2xl text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.02]">Want something like this for your product?</h2>
      <Button href="/contact" variant="black" arrow class="justify-self-start">Start a project</Button>
    </div>

    <nav aria-label="Case study" class="mt-6 flex flex-wrap justify-between gap-4 font-semibold text-amber">
      <a href="/work" class="inline-flex min-h-11 items-center gap-1.5 hover:underline">
        <ArrowIcon direction="left" /> All work
      </a>
      {
        links.code && (
          <a href={links.code} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:underline">
            Read the code on GitHub <ArrowIcon />
          </a>
        )
      }
    </nav>
  </div>
</section>
