---
// Rendered only when about.credentials has entries (see the About page).
import Pill from '../Pill.astro';
import { about } from '../../data/about';
---

<section class="bg-black pt-24 md:pt-28">
  <div class="container-site">
    <Pill>Certifications</Pill>
    <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">Credentials.</h2>
    <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        about.credentials.map((credential) => (
          <li class="flex items-center gap-4 rounded-card border border-line bg-charcoal p-6">
            <span class="size-12 shrink-0 rounded-xl border border-amber" aria-hidden="true" />
            <div>
              <h3 class="text-[17px] font-semibold tracking-normal">
                {credential.url ? (
                  <a href={credential.url} target="_blank" rel="noopener" class="hover:text-amber hover:underline">
                    {credential.name}
                  </a>
                ) : (
                  credential.name
                )}
              </h3>
              <p class="mt-0.5 text-sm text-text-muted">
                {credential.issuer} · {credential.year}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
