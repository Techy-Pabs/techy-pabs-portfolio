---
import Pill from '../Pill.astro';
import { about } from '../../data/about';
import { splitLastWord } from '../../lib/text';

const heading = splitLastWord(about.bring.title);
---

<section class="bg-black py-24 md:py-28">
  <div class="container-site">
    <div class="mx-auto max-w-3xl text-center">
      <Pill>What I bring</Pill>
      <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">
        {heading.before}<span class="text-amber">{heading.last}</span>
      </h2>
    </div>
    <ul class="mt-14 grid gap-4 lg:grid-cols-3">
      {
        about.bring.items.map((item, i) => (
          <li class="rounded-card-lg border border-line bg-charcoal p-8">
            <p class="font-mono text-[13px] text-amber">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-[22px] leading-tight">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
