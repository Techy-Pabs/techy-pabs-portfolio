---
// A plain list of every page, linked from the footer. Built from the collections, so it stays complete.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pill from '../components/Pill.astro';
import { newestFirst } from '../lib/projects';
import { getServices, serviceHref } from '../lib/services';

const services = await getServices();
const projects = (await getCollection('projects')).sort(newestFirst);

const groups = [
  {
    heading: 'Pages',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Portfolio', href: '/portfolio' },
      { label: 'Services', href: '/services' },
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  { heading: 'Services', links: services.map((s) => ({ label: s.data.title, href: serviceHref(s.id) })) },
  { heading: 'Case studies', links: projects.map((p) => ({ label: p.data.title, href: `/portfolio/${p.id}` })) },
];
---

<BaseLayout
  title="Sitemap"
  description="Sitemap of the TechyPabs site: every page, from services and case studies to about and contact."
  bodyClass="bg-hero"
>
  <section class="pt-32 pb-20 md:pt-40">
    <div class="container-site">
      <Pill>Sitemap</Pill>
      <h1 class="mt-6 text-[clamp(3rem,6vw,5rem)] leading-[1]">Every page.</h1>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {
          groups.map((group) => (
            <nav aria-label={group.heading}>
              <h2 class="font-pill text-[15px] font-normal tracking-label text-amber">{group.heading}</h2>
              <ul class="mt-3">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} class="inline-flex min-h-11 items-center text-lg text-text-soft hover:text-amber">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
