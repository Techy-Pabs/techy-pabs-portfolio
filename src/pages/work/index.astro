---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WorkHero from '../../components/work/WorkHero.astro';
import WorkList from '../../components/work/WorkList.astro';
import { newestFirst } from '../../lib/projects';

const projects = (await getCollection('projects')).sort(newestFirst);
---

<BaseLayout
  title="Work"
  description="Every project Abraham Bassey has shipped, each with a case study: the problem, how it works and how it was tested."
>
  <WorkHero projects={projects} />
  <WorkList projects={projects} />
  <section class="bg-black pt-16 pb-2 md:pt-20 md:pb-1">
    <div class="container-site">
      <CtaBlock heading="Your project could be the next one here." />
    </div>
  </section>
</BaseLayout>
