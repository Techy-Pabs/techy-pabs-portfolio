---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Faq from '../../components/Faq.astro';
import Pill from '../../components/Pill.astro';
import ProcessSection from '../../components/services/ProcessSection.astro';
import ServiceBlock from '../../components/services/ServiceBlock.astro';
import ToolboxSection from '../../components/services/ToolboxSection.astro';
import { servicesPage } from '../../data/services-page';
import { getServices } from '../../lib/services';
import { splitAround } from '../../lib/text';

const services = await getServices();
const { hero, faq, closing } = servicesPage;
const headline = splitAround(hero.headline, hero.highlight);
---

<BaseLayout
  title="AI backend development services"
  description="AI backend development services from Abraham Bassey: AI chatbot development, FastAPI backend development and LLM integration, each proven by a shipped project."
>
  <section class="bg-hero pt-32 pb-20 md:pt-40 md:pb-24">
    <div class="container-site text-center">
      <Pill>Services</Pill>
      <h1 class="mx-auto mt-6 max-w-5xl text-[clamp(3rem,7vw,6.25rem)] leading-[0.98]">
        {headline.before}<span class="text-amber">{headline.match}</span>{headline.after}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-text-muted">{hero.intro}</p>
      <Button href="/contact" arrow class="mt-9">{hero.cta}</Button>
    </div>
  </section>

  <section class="bg-black py-16 md:py-20" aria-label="Services">
    <ul class="container-site space-y-4">
      {
        services.map((service, i) => (
          <li>
            <ServiceBlock service={service} number={i + 1} />
          </li>
        ))
      }
    </ul>
  </section>

  <ProcessSection />
  <ToolboxSection />

  <section class="bg-black pb-8">
    <div class="container-site">
      <div class="text-center">
        <Pill>FAQ</Pill>
        <h2 class="mt-5 text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05]">{faq.title}</h2>
      </div>
      <Faq items={faq.items} class="mx-auto mt-10 max-w-[900px]" />
    </div>
  </section>

  <section class="bg-black py-24 md:py-28">
    <div class="container-site">
      <CtaBlock heading={closing.heading} buttonLabel={closing.button} />
    </div>
  </section>
</BaseLayout>
