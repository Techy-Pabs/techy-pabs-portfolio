---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pill from '../components/Pill.astro';
import ContactChannels from '../components/contact/ContactChannels.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { site } from '../site';
---

<BaseLayout
  title="Hire an AI backend engineer"
  description="Hire an AI backend engineer for your chatbot, FastAPI backend or LLM integration. Tell Abraham Bassey about your project by WhatsApp, email or the form."
  bodyClass="bg-hero"
>
  <section class="pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] lg:gap-12">
      <div>
        <Pill>Contact</Pill>
        <h1 class="mt-6 text-[clamp(3.25rem,6.2vw,5.75rem)] leading-[0.98]">
          Let's build something that <span class="text-amber">works.</span>
        </h1>
        <p class="mt-7 text-lg leading-relaxed text-text-muted">
          Tell me about your project. I'll reply with questions or a suggested next step. {site.replyTime}
        </p>
        <div class="mt-10">
          <ContactChannels />
        </div>
        <p class="mt-6 text-sm text-text-muted">
          {site.location} · {site.timezone} · working with clients worldwide
        </p>
      </div>

      <ContactForm />
    </div>
  </section>
</BaseLayout>
