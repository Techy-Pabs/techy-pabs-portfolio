---
// One case study template for every project. Astro builds a page per project at build time.
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseClosing from '../../components/case-study/CaseClosing.astro';
import CaseHero from '../../components/case-study/CaseHero.astro';
import CaseParts from '../../components/case-study/CaseParts.astro';
import CaseProblem from '../../components/case-study/CaseProblem.astro';
import CaseQuality from '../../components/case-study/CaseQuality.astro';
import CaseResults from '../../components/case-study/CaseResults.astro';
import CaseUnderTheHood from '../../components/case-study/CaseUnderTheHood.astro';
import { breadcrumbs } from '../../lib/structured-data';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
// The optional Markdown body: extra write-up shown after the results, when there is one.
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

// The social preview is the project's own cover, cropped to the 1200 x 630 shape that apps expect.
const socialImage = await getImage({ src: project.data.cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<BaseLayout
  title={`${project.data.title} case study: ${project.data.kind}`}
  description={`${project.data.title} case study: ${project.data.summary}`}
  image={{ src: socialImage.src, alt: project.data.cover.alt }}
  ogType="article"
  jsonLd={[breadcrumbs(['Portfolio', '/portfolio/'], [project.data.title, `/portfolio/${project.id}/`])]}
>
  <CaseHero project={project} />
  <CaseProblem project={project} />
  <CaseParts project={project} />
  <CaseUnderTheHood project={project} />
  <CaseQuality project={project} />
  <CaseResults project={project} />
  {
    hasBody && (
      <section class="bg-black pt-20">
        <div class="container-site max-w-3xl space-y-4 text-lg leading-relaxed text-text-muted">
          <Content />
        </div>
      </section>
    )
  }
  <CaseClosing project={project} />
</BaseLayout>
