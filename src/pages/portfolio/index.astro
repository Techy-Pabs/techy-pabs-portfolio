---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WorkHero from '../../components/portfolio/WorkHero.astro';
import WorkList from '../../components/portfolio/WorkList.astro';
import { newestFirst } from '../../lib/projects';

const projects = (await getCollection('projects')).sort(newestFirst);
---

<BaseLayout
  title="AI and backend engineering portfolio"
  description="AI and backend engineering portfolio of Abraham Bassey: every shipped project, each with a case study on the problem, how it works and how it was tested."
>
  <WorkHero projects={projects} />
  <WorkList projects={projects} />
  <section class="bg-black pt-16 pb-24 md:pt-20 md:pb-28">
    <div class="container-site">
      <CtaBlock heading="Your project could be the next one here." />
    </div>
  </section>
</BaseLayout>
